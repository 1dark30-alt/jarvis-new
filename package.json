    "@types/leaflet": "^1.9.21",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "mammoth": "^1.13.0",
    "mqtt": "^5.15.1",
    "node-hid": "^3.4.0",
    "pdf-parse": "^2.4.5",
    "smart-buffer": "^4.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@jitsi/robotjs": "^0.6.22",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20",
