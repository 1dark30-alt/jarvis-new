    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "framer-motion": "^12.33.0",
    "http-proxy": "^1.18.1",
    "next": "16.1.6",
    "openai": "^6.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "screenshot-desktop": "^1.15.4",
    "selfsigned": "^5.5.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "typescript": "^5",
