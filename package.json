{
  "name": "jarvis-client",
  "version": "1.1.0",
  "description": "Jarvis V5 - AI Desktop Assistant",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n NEXT,ELECTRON -c cyan,green \"next dev -H 127.0.0.1\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "start:electron": "electron ."
  },
